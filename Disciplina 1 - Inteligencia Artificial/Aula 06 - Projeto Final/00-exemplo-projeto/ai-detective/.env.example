# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Chave da API. Fica só no servidor — nunca é exposta ao navegador.
# Crie a sua em https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelos (opcionais — estes são os padrões).
# gpt-4o-mini é barato, mas raciocina de forma rasa (às vezes erra a comparação entre
# depoimento e registro). Para investigações melhores, use OPENAI_CHAT_MODEL=gpt-4o.
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Banco de dados (Postgres + pgvector) ────────────────────────────────────
# Local: o Postgres do docker-compose (npm run db:up).
# AWS:   troque DB_HOST pelo endpoint do RDS e ligue DB_SSL=true.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_detective
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
