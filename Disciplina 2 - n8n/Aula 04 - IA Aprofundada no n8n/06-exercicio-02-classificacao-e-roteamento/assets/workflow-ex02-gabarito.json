      ],
      "id": "EscolherreclamacaoC",
      "name": "Escolher reclamacao"
    },
    {
      "parameters": {
        "jsCode": "const sistema = 'Classifique a intencao da reclamacao: venda (quer comprar ou conhecer produtos), suporte (problema com produto, entrega, troca ou uso), financeiro (cobranca, estorno, reembolso, pagamento ou boleto), outro (qualquer outro assunto).';\nconst corpo = { model: 'gpt-4o-mini', messages: [ { role: 'system', content: sistema }, { role: 'user', content: $json.mensagem } ], response_format: {\"type\": \"json_schema\", \"json_schema\": {\"name\": \"intencao\", \"strict\": true, \"schema\": {\"type\": \"object\", \"properties\": {\"intencao\": {\"type\": \"string\", \"enum\": [\"venda\", \"suporte\", \"financeiro\", \"outro\"]}, \"confianca\": {\"type\": \"number\"}}, \"required\": [\"intencao\", \"confianca\"], \"additionalProperties\": false}}} };\nreturn { json: { ...$json, corpo: JSON.stringify(corpo) } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "MontarcorpoClassificC",
      "name": "Montar corpo Classificar intencao"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.corpo }}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        770,
        0
      ],
      "id": "ClassificarintencaoH",
      "name": "Classificar intencao",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "LLM Bearer Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const dados = JSON.parse($input.item.json.choices[0].message.content); const original = $('Escolher reclamacao').first().json; return { json: { reclamacao_id: original.id, protocolo: original.protocolo, intencao: dados.intencao, confianca: dados.confianca } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        990,
        0
      ],
      "id": "LerintencaoC",
