      "parameters": {
        "jsCode": "const politicas = $json.politicas.map(p => p.titulo + ': ' + p.texto).join('\\n');\nconst sistema = 'Responda somente com base na base de conhecimento abaixo. Cite o trecho que usou. Se a informacao nao estiver na base, responda exatamente: Nao encontrei essa informacao.';\nconst corpo = { model: 'gpt-4o-mini', messages: [ { role: 'system', content: sistema }, { role: 'user', content: 'Base:\\n' + politicas + '\\n\\nPergunta: ' + $json.mensagem } ] };\nreturn { json: { corpo: JSON.stringify(corpo) } };"
      },
