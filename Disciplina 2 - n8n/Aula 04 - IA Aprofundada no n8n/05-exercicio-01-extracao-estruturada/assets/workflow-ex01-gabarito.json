      "parameters": {
        "jsCode": "const sistema = 'Extraia os dados da reclamacao do cliente. Use null quando a informacao nao existir no texto.';\nconst corpo = { model: 'gpt-4o-mini', messages: [ { role: 'system', content: sistema }, { role: 'user', content: $json.mensagem } ], response_format: {\"type\": \"json_schema\", \"json_schema\": {\"name\": \"extracao_pedido\", \"strict\": true, \"schema\": {\"type\": \"object\", \"properties\": {\"numero_pedido\": {\"type\": [\"string\", \"null\"]}, \"produto\": {\"type\": [\"string\", \"null\"]}, \"motivo\": {\"type\": \"string\", \"enum\": [\"troca\", \"defeito\", \"atraso\", \"outro\"]}, \"urgente\": {\"type\": \"boolean\"}}, \"required\": [\"numero_pedido\", \"produto\", \"motivo\", \"urgente\"], \"additionalProperties\": false}}} };\nreturn { json: { ...$json, corpo: JSON.stringify(corpo) } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "MontarcorpoExtrairdaC",
      "name": "Montar corpo Extrair dados"
    },
