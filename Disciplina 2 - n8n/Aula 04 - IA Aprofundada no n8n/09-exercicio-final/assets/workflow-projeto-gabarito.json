      ],
      "id": "g1",
      "name": "Buscar reclamacoes novas"
    },
    {
      "parameters": {
        "jsCode": "const sistema = 'Classifique a intencao da reclamacao: venda, suporte (problema com produto, entrega, troca ou uso), financeiro (cobranca, estorno, reembolso), outro.';\nconst corpo = { model: 'gpt-4o-mini', messages: [ { role: 'system', content: sistema }, { role: 'user', content: $json.mensagem } ], response_format: {\"type\": \"json_schema\", \"json_schema\": {\"name\": \"intencao\", \"strict\": true, \"schema\": {\"type\": \"object\", \"properties\": {\"intencao\": {\"type\": \"string\", \"enum\": [\"venda\", \"suporte\", \"financeiro\", \"outro\"]}, \"confianca\": {\"type\": \"number\"}}, \"required\": [\"intencao\", \"confianca\"], \"additionalProperties\": false}}} };\nreturn { json: { ...$json, corpo: JSON.stringify(corpo) } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "MontarcorpoEtapa1intC",
      "name": "Montar corpo Etapa 1 intencao"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.corpo }}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        550,
        0
      ],
      "id": "Etapa1intencaoH",
      "name": "Etapa 1 intencao",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "LLM Bearer Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const dados = JSON.parse($input.item.json.choices[0].message.content); const original = $('Buscar reclamacoes novas').item.json; return { json: { ...original, intencao: dados.intencao, confianca: dados.confianca } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        770,
        0
      ],
      "id": "LerintencaoC",
      "name": "Ler intencao"
    },
    {
      "parameters": {
        "jsCode": "const sistema = 'Extraia os dados da reclamacao. Use null quando nao existir no texto.';\nconst corpo = { model: 'gpt-4o-mini', messages: [ { role: 'system', content: sistema }, { role: 'user', content: $json.mensagem } ], response_format: {\"type\": \"json_schema\", \"json_schema\": {\"name\": \"extracao_pedido\", \"strict\": true, \"schema\": {\"type\": \"object\", \"properties\": {\"numero_pedido\": {\"type\": [\"string\", \"null\"]}, \"produto\": {\"type\": [\"string\", \"null\"]}, \"motivo\": {\"type\": \"string\", \"enum\": [\"troca\", \"defeito\", \"atraso\", \"outro\"]}, \"urgente\": {\"type\": \"boolean\"}}, \"required\": [\"numero_pedido\", \"produto\", \"motivo\", \"urgente\"], \"additionalProperties\": false}}} };\nreturn { json: { ...$json, corpo: JSON.stringify(corpo) } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        990,
        0
      ],
      "id": "MontarcorpoEtapa2extC",
      "name": "Montar corpo Etapa 2 extracao"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.corpo }}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "id": "Etapa2extracaoH",
      "name": "Etapa 2 extracao",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "LLM Bearer Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const extr = JSON.parse($input.item.json.choices[0].message.content); const ant = $('Ler intencao').item.json; return { json: { ...ant, extracao: extr } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "id": "LerextracaoC",
      "name": "Ler extracao"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://3.210.122.73:8080/api/politicas",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -150
      ],
      "id": "g2",
      "name": "Buscar politicas (uma vez)"
    },
    {
      "parameters": {
        "jsCode": "const politicas = $('Buscar politicas (uma vez)').all().map(i=>i.json); const texto = politicas.map(p=>p.titulo+': '+p.texto).join('\\n'); const ant = $('Ler extracao').item.json; return { json: { ...ant, politicas_texto: texto } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "id": "JuntarpoliticasC",
      "name": "Juntar politicas"
    },
    {
      "parameters": {
        "jsCode": "const sistema = 'Responda somente com base na base de conhecimento. Cite o trecho usado. Se nao encontrar, responda exatamente: Nao encontrei essa informacao.';\nconst corpo = { model: 'gpt-4o-mini', messages: [ { role: 'system', content: sistema }, { role: 'user', content: 'Base:\\n' + $json.politicas_texto + '\\n\\nPergunta: ' + $json.mensagem } ] };\nreturn { json: { ...$json, corpo: JSON.stringify(corpo) } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "id": "MontarcorpoEtapa3resC",
      "name": "Montar corpo Etapa 3 resposta"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.corpo }}",
        "options": {
          "timeout": 15000
        }
