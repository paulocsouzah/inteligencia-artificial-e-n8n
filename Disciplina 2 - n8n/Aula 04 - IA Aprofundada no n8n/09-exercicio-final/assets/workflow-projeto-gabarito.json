      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1870,
        0
      ],
      "id": "Etapa3respostaH",
      "name": "Etapa 3 resposta",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "LLM Bearer Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ant = $('Juntar politicas').item.json; const resposta = $input.item.json.choices[0].message.content;\nlet acao = 'respondido_automaticamente';\nif (ant.confianca < 0.7 || resposta.includes('Nao encontrei')) acao = 'encaminhado_humano';\nelse if (ant.intencao === 'venda') acao = 'encaminhado_vendas';\nreturn { json: { id: ant.id, protocolo: ant.protocolo, cliente_nome: ant.cliente_nome, cliente_email: ant.cliente_email, intencao: ant.intencao, confianca: ant.confianca, resposta, acao } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2090,
        0
      ],
      "id": "DecidiracaoC",
      "name": "Decidir acao"
    },
    {
      "parameters": {
        "jsCode": "const d = $json; const statusFinal = d.acao === 'respondido_automaticamente' ? 'respondida' : (d.acao === 'encaminhado_vendas' ? 'encaminhado_vendas' : 'escalada');\nconst corpo = { status: statusFinal, intencao: d.intencao, resposta: d.resposta };\nreturn { json: { ...d, corpo_patch: JSON.stringify(corpo) } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2310,
        0
      ],
      "id": "MontarpatchC",
      "name": "Montar patch"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=http://3.210.122.73:8080/api/reclamacoes/{{ $json.id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.corpo_patch }}",
