      "id": "Etapa1intencaoH",
      "name": "Etapa 1 intencao",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "LLM Bearer Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const dados = JSON.parse($input.item.json.choices[0].message.content); const original = $('Escolher reclamacao').first().json; return { json: { ...original, intencao: dados.intencao, confianca: dados.confianca } };"
      },
      "type": "n8n-nodes-base.code",
