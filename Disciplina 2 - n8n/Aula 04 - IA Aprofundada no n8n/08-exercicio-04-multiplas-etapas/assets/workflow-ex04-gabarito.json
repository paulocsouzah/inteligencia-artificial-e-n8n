      "name": "Escolher reclamacao"
    },
    {
      "parameters": {
        "jsCode": "const sistema = 'Classifique a intencao da reclamacao: venda, suporte (problema com produto, entrega, troca ou uso), financeiro (cobranca, estorno, reembolso), outro.';\nconst corpo = { model: 'gpt-4o-mini', messages: [ { role: 'system', content: sistema }, { role: 'user', content: $json.mensagem } ], response_format: {\"type\": \"json_schema\", \"json_schema\": {\"name\": \"intencao\", \"strict\": true, \"schema\": {\"type\": \"object\", \"properties\": {\"intencao\": {\"type\": \"string\", \"enum\": [\"venda\", \"suporte\", \"financeiro\", \"outro\"]}, \"confianca\": {\"type\": \"number\"}}, \"required\": [\"intencao\", \"confianca\"], \"additionalProperties\": false}}} };\nreturn { json: { corpo: JSON.stringify(corpo) } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "MontarcorpoEtapa1intC",
      "name": "Montar corpo Etapa 1 intencao"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.corpo }}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        770,
        0
