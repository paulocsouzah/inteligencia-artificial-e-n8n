        "jsCode": "const politicas = $json.politicas.map(p => p.titulo + ': ' + p.texto).join('\\n');\nconst sistema = 'Responda somente com base na base de conhecimento. Cite o trecho usado. Se nao encontrar, responda exatamente: Nao encontrei essa informacao.';\nconst corpo = { model: 'gpt-4o-mini', messages: [ { role: 'system', content: sistema }, { role: 'user', content: 'Base:\\n' + politicas + '\\n\\nPergunta: ' + $json.mensagem } ] };\nreturn { json: { ...$json, corpo: JSON.stringify(corpo) } };"
      },
