# Copie este arquivo para "terraform.tfvars" (ele fica fora do Git — veja o .gitignore)
# e preencha com os SEUS valores.

my_ip       = "SEU_IP_PUBLICO_AQUI"   # descubra em https://www.meuip.com.br/
db_password = "UMA_SENHA_FORTE_AQUI"  # só letras e números, 8+ caracteres

